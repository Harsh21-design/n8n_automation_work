# ==========================================
# N8N SERVER CONFIGURATION
# ==========================================
N8N_HOST=https://n8n.vkapsprojects.com
N8N_API_KEY=your_n8n_api_key_here
GENERIC_TIMEZONE=Asia/Kolkata

# ==========================================
# MEETING INTELLIGENCE API
# ==========================================
# Fireflies.ai API Key (used for GraphQL queries & transcript webhooks)
FIREFLIES_API_KEY=your_fireflies_api_key_here

# ==========================================
# N8N HOSTED CREDENTIALS DISCLOSURE
# Note: All integration credentials listed below are pre-configured directly
# within the n8n Credentials Manager Dashboard:
# https://n8n.vkapsprojects.com/settings/credentials
# ==========================================
# 1. AI Models: Anthropic (Claude Sonnet/Haiku) & OpenAI (GPT-5/Embeddings)
ANTHROPIC_API_KEY=configured_in_n8n_dashboard
OPENAI_API_KEY=configured_in_n8n_dashboard

# 2. Google Workspace: Google Drive, Google Docs, Google Sheets, Gmail OAuth2
GOOGLE_DRIVE_OAUTH2=configured_in_n8n_dashboard
GOOGLE_DOCS_OAUTH2=configured_in_n8n_dashboard
GOOGLE_SHEETS_OAUTH2=configured_in_n8n_dashboard
GMAIL_OAUTH2=configured_in_n8n_dashboard

# 3. Vector Database & Document Processing: Supabase Vector Store & PDF4me API
SUPABASE_API_KEY=configured_in_n8n_dashboard
PDF4ME_API_KEY=configured_in_n8n_dashboard
