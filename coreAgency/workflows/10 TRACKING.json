    {
      "parameters": {
        "jsCode": "const estimate = $('retrieve_estimate').first().json;\nconst taskTypeData = $('taskypes_ID&Name').first().json;\n\nconst rawClientName = $input.first().json.clientName || \"\";\nconst jobNumber = $input.first().json.jobNumber || \"\";\nconst jobDescription = $input.first().json.description || \"\";\nconst jobType = $input.first().json.job_type || \"\";\n\n/**\n * Client Format\n * Example:\n * ABCD0001 -> ABCD | Client Name\n */\nconst clientPrefix = String(jobNumber).substring(0, 4);\nconst clientName = `${clientPrefix} | ${rawClientName}`;\n\n/**\n * Helpers\n */\nconst safe = (value, fallback = \"\") => {\n  if (value === null || value === undefined) return fallback;\n\n  return String(value)\n    .replace(/&gt;/g, \">\")\n    .replace(/&lt;/g, \"<\")\n    .replace(/\\r?\\n/g, \" \")\n    .replace(/\\s+/g, \" \")\n    .trim();\n};\n\nconst money = (value) =>\n  Number(value || 0).toFixed(2);\n\n/**\n * Dynamic Task Type Mapping\n */\nconst taskTypeMap = {};\n\n(taskTypeData.id || []).forEach((id, index) => {\n  taskTypeMap[id] = {\n    name: taskTypeData.name?.[index] || \"\",\n    code: taskTypeData.code?.[index] || \"\"\n  };\n});\n\n/**\n * Dynamic Charge Type Mapping\n */\nconst chargeTypeMap = {\n  1: \"Time\",\n  2: \"Fixed\",\n  3: \"Cost\"\n};\n\n/**\n * Build Estimate Entries\n */\nconst entries = [];\n\n(estimate.entries || []).forEach((entry, index) => {\n\n  const units = Number(entry.units || 0);\n  const rate = Number(entry.rate || 0);\n  const tax = Number(entry.tax || 0);\n  const markUp = Number(entry.markUp || 0);\n  const serviceFee = Number(entry.serviceFee || 0);\n\n  const estimateTotal =\n    (units * rate) +\n    tax +\n    markUp +\n    serviceFee;\n\n  const mappedTask =\n    taskTypeMap[entry.taskTypeId] || {};\n\n  entries.push(`\nEstimate Entry ${index + 1}\n\nClient: ${safe(clientName)}\nProduct:\nJob No.: ${safe(jobNumber)}\nJob Description: ${safe(jobDescription)}\nVersion No.: ${money(estimate.version || 0)}\nTitle: ${safe(estimate.title)}\nSuperseded: ${safe(estimate.superseded)}\nDate: ${safe(estimate.date)}\nCurrency Code: A$\nHeadings Description: ${safe(estimate.title)}\nCharge Type: ${\n  chargeTypeMap[entry.chargeTypeId] ||\n  safe(entry.chargeTypeId)\n}\nTask Type Code: ${safe(mappedTask.code)}\nTask Type Name: ${safe(mappedTask.name)}\nDescription: ${safe(entry.description)}\nUnits: ${money(units)}\nRate: ${money(rate)}\nMark Ups: ${money(markUp)}\nService Fee: ${money(serviceFee)}\nTax: ${money(tax)}\nEstimate Total: ${money(estimateTotal)}\nEstimate Notes: ${safe(entry.notes)}\nLine Notes:\n\n--------------------------------------------------\n`.trim());\n\n});\n\n/**\n * Final Page Content\n */\nconst pageContent = entries.join('\\n\\n');\n\n/**\n * Return\n */\nreturn [\n  {\n    json: {\n      job_type: jobType,\n      job_number: jobNumber,\n      client: clientName,\n      pageContent\n    }\n  }\n];"
      },
